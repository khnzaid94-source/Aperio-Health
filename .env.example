# Copy to .env (backend, loaded via system env / Render dashboard) and configure.

# Backend — Google OAuth audience used to verify ID tokens server-side
GOOGLE_CLIENT_ID=

# Frontend build-time — enables the Google sign-in button
VITE_GOOGLE_CLIENT_ID=

# Comma-separated list of allowed browser origins for the API
ALLOWED_ORIGIN=http://localhost:3000

# NEVER commit real secrets. GEMINI_API_KEY goes only in your local shell /
# Render dashboard, never in this file or any committed file.
GEMINI_API_KEY=
